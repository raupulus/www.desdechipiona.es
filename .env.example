# Configuración de la aplicación
APP_NAME="Desde Chipiona"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://desdechipiona.es
APP_TIMEZONE=Europe/Madrid

# Localización
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Base de datos — PostgreSQL (OBLIGATORIO: desdechipiona)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=desdechipiona
DB_USERNAME=dev
DB_PASSWORD=

# Cache y Sesiones
CACHE_STORE=file
CACHE_PREFIX=desdechipiona_dev_
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Colas y Almacenamiento
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Autenticación y Registro (desactivado por diseño: solo el administrador crea usuarios en /admin o por CLI)
AUTH_REGISTRATION_ENABLED=false

# Redis (opcional en desarrollo)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email — Correos oficiales de Desde Chipiona
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@desdechipiona.es"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS="info@desdechipiona.es"

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Frontend & Vite
VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (en TODOS los formularios públicos; vacío en local/tests omite verificación)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google reCAPTCHA v3 (compatibilidad opcional; vacío en local/tests omite verificación)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# OAuth Ligero para Participación Vecinal sin Cuentas Locales (Facebook / Google)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/social/facebook/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/social/google/callback"

# AEMET OpenData (Municipio 11016 - Chipiona)
AEMET_API_KEY=
AEMET_MUNICIPALITY_CODE=11016
