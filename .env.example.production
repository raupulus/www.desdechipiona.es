# Archivo de ejemplo de variables de entorno para PRODUCCIÓN — Desde Chipiona
# Copia este archivo como .env y ajusta los valores para producción

APP_NAME="Desde Chipiona"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://desdechipiona.es
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Base de datos PostgreSQL (obligatoria para producción)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=desdechipiona
DB_USERNAME=desdechipiona_user
DB_PASSWORD=

# Caché — Redis recomendado para producción
CACHE_STORE=redis
CACHE_PREFIX=desdechipiona_

# Colas — Database o Redis para producción
QUEUE_CONNECTION=database

# Sesiones — Redis recomendado para producción
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Email — Configuración SMTP para producción
MAIL_MAILER=smtp
MAIL_HOST=smtp.desdechipiona.es
MAIL_PORT=587
MAIL_USERNAME=no-reply@desdechipiona.es
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@desdechipiona.es
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS=info@desdechipiona.es

# Redis — Para caché y colas
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Storage — Filesystem local o S3 para producción
FILESYSTEM_DISK=local

# Sanctum — Dominio del frontend
SANCTUM_STATEFUL_DOMAINS=desdechipiona.es

# Cloudflare Turnstile (Obligatorio en todos los envíos de formularios en producción)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google reCAPTCHA v3 (compatibilidad opcional)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# OAuth Ligero para Participación Vecinal sin Cuentas Locales (Facebook / Google)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/social/facebook/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/social/google/callback"

# AEMET OpenData (Municipio 11016 - Chipiona)
AEMET_API_KEY=
AEMET_MUNICIPALITY_CODE=11016

# Logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Broadcasting (desactivado por defecto)
BROADCAST_CONNECTION=null
